# GitHub Actions workflow: nightly differential fuzzing of the parser against tsgo's (tools/fuzz/parser.mjs, docs/RUST.md
# "Differential fuzzing"). A failed run means the Rust parser built a different AST from Go's for some input; the
# inputs, their parse flags and the diff of the two dumps are in the `fuzz-findings` artifact.

name: Fuzz

on:
  schedule:
    - cron: "17 6 * * *"
  workflow_dispatch:

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always

jobs:
  parser:
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    steps:
      - uses: taiki-e/checkout-action@7d1e50e93dc4fb3bba58f85018fadf77898aee8b # v1.4.2

      - uses: oxc-project/setup-node@f46a72f95efdc55273fcd042d61c84e723b2892c # v1.4.1

      - name: Read TypeScript reference commit
        id: ts
        run: echo "commit=$(node npm/build.mjs --print-typescript-commit)" >> "$GITHUB_OUTPUT"

      # The Go oracle builds from ts-ref/tsc; the corpus is ts-ref/tsc/testdata/tests/cases.
      - name: Check out TypeScript
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: microsoft/TypeScript
          ref: ${{ steps.ts.outputs.commit }}
          path: ts-ref
          fetch-depth: 1
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /tsc/
            !/tsc/testdata/baselines/
          persist-credentials: false

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: ts-ref/tsc/go.mod
          cache-dependency-path: ts-ref/tsc/go.sum

      - uses: oxc-project/setup-rust@3d6fb132fbe7cdcb66bf8ec193911c2945369d12 # v1.0.17
        with:
          save-cache: true
          cache-key: fuzz

      - name: Build the AST oracles
        run: sh tools/oracle/ast/build.sh

      # A new seed every day; the seed is printed, so a finding can be reproduced locally.
      - name: Fuzz the parser
        run: node tools/fuzz/parser.mjs --rounds 50 --per-round 4000 --seed "$(date -u +%Y%m%d)" --jobs "$(nproc)"

      - name: Upload findings
        if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: fuzz-findings
          path: target/fuzz-parser
          if-no-files-found: ignore
