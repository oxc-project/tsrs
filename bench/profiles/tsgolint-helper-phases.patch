diff --git a/crates/tsrs_lint/src/profile.rs b/crates/tsrs_lint/src/profile.rs
new file mode 100644
--- /dev/null
+++ b/crates/tsrs_lint/src/profile.rs
@@ -0,0 +1,33 @@
+use std::sync::OnceLock;
+use std::time::Instant;
+use tsrs_core::json::{self, Value};
+static CLOCK: OnceLock<Instant> = OnceLock::new();
+pub fn cpu() -> u64 {
+    #[repr(C)]
+    struct Timespec { tv_sec: i64, tv_nsec: i64 }
+    unsafe extern "C" { fn clock_gettime(id: i32, tp: *mut Timespec) -> i32; }
+    let mut ts = Timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: the writable timespec is initialized and clock_gettime retains no pointer.
+    assert_eq!(unsafe { clock_gettime(16, &raw mut ts) }, 0);
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+pub fn mark() -> (Instant, u64) {
+    CLOCK.get_or_init(Instant::now);
+    (Instant::now(), cpu())
+}
+pub fn elapsed(start: (Instant, u64)) -> (u64, u64) {
+    (start.0.elapsed().as_nanos() as u64, cpu() - start.1)
+}
+pub fn number(n: u64) -> Value { Value::Integer(n as i64) }
+pub fn record(event: &str, start: (Instant, u64), fields: impl IntoIterator<Item=(&'static str, Value)>) {
+    let (wall, cpu) = elapsed(start);
+    let fields = [
+        ("event", Value::String(event.into())),
+        ("t_ns", number(CLOCK.get().unwrap().elapsed().as_nanos() as u64)),
+        ("wall_ns", number(wall)), ("cpu_ns", number(cpu)),
+    ].into_iter().chain(fields);
+    eprintln!("TSRS_PHASE {}", json::marshal(&crate::protocol::object(fields)).unwrap());
+}
+pub fn add(wall: &mut [u64; 4], cpu: &mut [u64; 4], index: usize, start: (Instant, u64)) {
+    let (w, c) = elapsed(start); wall[index] += w; cpu[index] += c;
+}
