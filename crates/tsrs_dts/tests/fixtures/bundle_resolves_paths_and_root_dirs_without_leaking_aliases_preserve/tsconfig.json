{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "paths": {
      "@internal/*": [
        "./src/shared/*"
      ]
    },
    "rootDirs": [
      "./src/app",
      "./src/generated"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
