{
  "name": "@tsrs/napi",
  "version": "0.0.0",
  "private": true,
  "description": "The tsrs sync API with its session in the Node process instead of a tsrs --api child process",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxc-project/tsrs.git",
    "directory": "napi"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src-js/index.d.mts",
      "default": "./src-js/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["src-js"],
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "build-dev": "node scripts/build.mjs",
    "build": "node scripts/build.mjs --release",
    "test": "node test/run-sync.mjs"
  },
  "dependencies": { "tsrs": "link:../npm/tsrs" }
}
