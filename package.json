{
    "name": "tsrs-tooling",
    "version": "0.19.0-ts7.1.0-beta",
    "private": true,
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "build:dev": "cargo build --profile dev -p tsrs_cli -p tsrs_testrunner -p tsrs_determinism",
        "lint": "pnpm lint:source && pnpm lint:rust && pnpm check:scripts",
        "lint:source": "node tools/lint/source.mjs",
        "lint:rust": "cargo clippy --all-targets --config 'build.warnings=\"deny\"'",
        "check:scripts": "node tools/check-scripts.mjs",
        "test:tooling": "node --test tools/gen-diagnostics/test_*.mjs tools/go-fourslash/test_*.mjs tools/repo-conformance/test_*.mjs",
        "test:bench": "node --test bench/bench.test.mjs",
        "test:regressions": "bash tools/regressions.sh",
        "test:contentmapper": "bash tools/contentmapper-e2e.sh",
        "bench": "node bench/bench.mjs",
        "bench:measure": "node bench/measure.mjs",
        "bench:count": "node bench/count.mjs",
        "bench:wallclock": "node bench/wallclock.mjs",
        "gen": "bash tools/gen-check.sh",
        "gen:ast": "node tools/gen-ast/gen-ast.ts",
        "gen:flags": "node tools/gen-ast/gen-flags.ts",
        "gen:codec": "node crates/tsrs_api_codec/gen/gen-codec.ts",
        "gen:codec-oracle": "node crates/tsrs_api_codec/gen/oracle.mjs",
        "gen:codec-probe": "bash crates/tsrs_api_codec/gen/goprobe.sh",
        "gen:api-probe": "bash crates/tsrs_api/src/checker/testdata/go_probe/regen.sh",
        "gen:diagnostics": "node tools/gen-diagnostics/gen.mjs",
        "gen:libs": "node tools/gen-libs/gen.mjs",
        "gen:lsproto": "node tools/gen-lsproto/generate.mts",
        "gen:lsproto-model": "node tools/gen-lsproto/fetchModel.mts",
        "gen:tsoptions": "node tools/gen-tsoptions/gen_decls.mjs",
        "gen:tsconfig-tests": "node tools/gen-tsoptions/gen_tsconfig_tests.mjs",
        "gen:signatures": "node tools/sigs-from-rust.mjs",
        "localization:check": "node tools/gen-diagnostics/check_localizations.mjs",
        "localization:import": "node tools/gen-diagnostics/import_localization.mjs",
        "lsproto:check": "node tools/gen-lsproto/check.mjs",
        "fourslash": "node tools/go-fourslash/run.mjs",
        "fourslash:summarize": "node tools/go-fourslash/summarize.mjs",
        "fourslash:gate": "bash .github/scripts/go-fourslash-gate.sh",
        "ci:conformance": "bash .github/scripts/conformance-gate.sh",
        "ci:diagnostics": "node tools/ci/compare_diagnostics.mjs",
        "ci:skip-marker": "node tools/ci/skip_marker.mjs",
        "ci:determinism": "cargo run --profile dev -p tsrs_determinism -- check && cargo run --profile dev -p tsrs_determinism -- regressions",
        "ci:tsan": "bash tools/ci/tsan.sh",
        "ci:tsan-summary": "node tools/ci/tsan_summary.mjs",
        "ci:workloads": "node tools/ci/workloads.mjs",
        "ci:release-wasm": "node .github/scripts/restore-release-wasm.mjs",
        "ci:wait-npm": "node .github/scripts/wait-for-npm-packages.mjs",
        "ci:triage-labels": "bash .github/scripts/setup-triagebot-labels.sh",
        "perf:verify": "node tools/perf/verify.mjs",
        "perf:layout": "node tools/perf/layout-measure.mjs",
        "perf:leaf": "node tools/perf/leafprobe.mjs",
        "perf:slack": "node tools/perf/slackprobe.mjs",
        "perf:cluster": "node tools/perf/clusterprobe.mjs",
        "perf:probe": "bash tools/perf/probe.sh",
        "perf:leaf-workflow": "bash tools/perf/leafprobe.sh",
        "perf:slack-workflow": "bash tools/perf/slackprobe.sh",
        "perf:pgo-train": "bash .github/scripts/pgo-train.sh",
        "perf:bolt": "bash .github/scripts/bolt.sh",
        "watch:check": "node tools/watch/watchcheck.mjs",
        "watch:latency": "node tools/watch/watchlat.mjs",
        "watch:during-job": "node tools/watch/editduringjob.mjs",
        "watch:save-patterns": "node tools/watch/savepatterns.mjs",
        "oracle:ast": "node tools/oracle/ast/run.mjs",
        "oracle:ast-build": "bash tools/oracle/ast/build.sh",
        "oracle:ast-fields": "node tools/oracle/ast/gen-fields.ts",
        "oracle:printer": "node tools/oracle/printer/run.mjs",
        "oracle:printer-build": "bash tools/oracle/printer/build.sh",
        "oracle:emit": "node tools/oracle/emit/run.mjs",
        "oracle:emit-cases": "node tools/oracle/emit/cases.mjs",
        "oracle:emit-monorepo": "bash tools/oracle/emit/monorepo.sh",
        "oracle:emit-summary": "node tools/oracle/emit/summarize.mjs",
        "oracle:emit-select": "node tools/oracle/emit/select-packages.mjs",
        "oracle:emit-packages": "node tools/oracle/emit/list-packages.js",
        "oracle:emit-test-monorepo": "bash tools/oracle/emit/test_monorepo.sh",
        "oracle:emit-test-buildinfo": "bash tools/oracle/emit/test_run_buildinfo.sh",
        "oracle:incremental": "bash tools/oracle/incremental/steps.sh",
        "oracle:incremental-fixtures": "bash tools/oracle/incremental/fixtures/run-all.sh",
        "oracle:lsp": "node tools/oracle/lsp/lsp_oracle.mjs",
        "oracle:lsp-exit": "node tools/oracle/lsp/exit_check.mjs",
        "oracle:completions": "node tools/oracle/completions/record.mjs",
        "oracle:lsproto": "bash tools/oracle/lsproto/run.sh",
        "oracle:lsproto-registry": "node tools/oracle/lsproto/gen_registry.mjs",
        "oracle:lsproto-mutate": "node tools/oracle/lsproto/mutate.mjs",
        "oracle:module": "node tools/oracle/module/gen.mjs",
        "oracle:modulespecifiers": "node tools/oracle/modulespecifiers/gen.mjs",
        "oracle:tsc-dump": "bash tools/oracle/tsctests/dump.sh",
        "oracle:json-cases": "node crates/tsrs_api_transport/tests/fixtures/go_json_oracle_cases.mjs",
        "oracle:syntax-cases": "node crates/tsrs_api_transport/tests/fixtures/go_syntax_oracle_cases.mjs",
        "oracle:refs-record": "node crates/tsrs_ls/testdata/refs_smoke/drive.mjs",
        "fuzz:parser": "node tools/fuzz/parser.mjs",
        "mutate": "node tools/mutate/mutate.mjs",
        "lsp:memory": "node tools/lsp-mem/lsp_mem.mjs",
        "types:sample": "node tools/project-types-sample.mjs",
        "types:compare": "node tools/project-types-compare.mjs",
        "types:packages": "bash tools/project-types-packages.sh",
        "diffs:cluster": "node tools/cluster-diffs.mjs",
        "repo-conformance": "node tools/repo-conformance/run.mjs",
        "node-api:setup": "bash tools/node-api/setup.sh",
        "node-api:upstream": "node tools/node-api/run-upstream.mjs",
        "node-api:compare": "node tools/node-api/compare-responses.mjs",
        "node-api:inventory": "node tools/node-api/inventory.mjs",
        "node-api:consumer": "node tools/node-api/consumer.mjs",
        "node-api:controls": "node tools/node-api/controls/run-controls.mjs",
        "node-api:scenario": "node tools/node-api/controls/scen.mjs",
        "node-api:scenario2": "node tools/node-api/controls/scen2.mjs",
        "node-api:scenario3": "node tools/node-api/controls/scen3.mjs",
        "node-api:scenario4": "node tools/node-api/controls/scen4.mjs",
        "node-api:scenario-extra": "node tools/node-api/controls/scen-extra.mjs",
        "wasm:build": "bash tools/wasm/build.sh",
        "wasm:gate": "bash tools/wasm/gate.sh",
        "wasm:diff": "node tools/wasm/diff.mjs",
        "wasm:bench": "node tools/wasm/bench.mjs",
        "upstream:measure": "node upstream/tools/measure.mjs",
        "upstream:summarize": "node upstream/tools/summarize.mjs",
        "upstream:testfiles": "bash upstream/tools/testfiles.sh",
        "npm:build": "node npm/build.mjs",
        "sdk:sync": "node npm/sdk/sync-upstream.mjs",
        "sdk:coverage": "node npm/sdk/method-coverage.mjs",
        "sdk:record": "node npm/sdk/coverage/record-methods.mjs",
        "sdk:smoke": "node npm/sdk/smoke-consumer.mjs",
        "wasm:serve-example": "node npm/tsrs-wasm/examples/browser/serve.mjs"
    },
    "devDependencies": {
        "typescript": "7.1.0-beta",
        "void": "1.2.1"
    },
    "engines": {
        "node": ">=24"
    }
}
